# Anthropic-compatible endpoint
ANTHROPIC_BASE_URL=http://127.0.0.1:8045

# Anthropic API
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# E2E / mock testing
MOCK_BRAINSTORM=1
E2E_BASE_URL=http://127.0.0.1:3000

# Cloudflare Turnstile (https://dash.cloudflare.com/turnstile)
# Default to disabled so local/dev runs work out of the box.
# In production, set NEXT_PUBLIC_ENABLE_TURNSTILE=true and configure the keys.
NEXT_PUBLIC_ENABLE_TURNSTILE=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Escape hatch: force-disable Turnstile even if enabled + keys are set.
# (Alias also supported: DISABLE_TURNSTILE=1)
# TURNSTILE_DISABLED=1
